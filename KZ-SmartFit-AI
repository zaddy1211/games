end
function T.train(records,options,tick)
    local ok,result=pcall(checkedTrain,records,options or {},tick)
    if not ok then return nil,tostring(result) end
    return result
end

function T.newJob(records,options)
    if options~=nil and type(options)~="table" then return nil,"training-options-required" end
    options=U.copy(options or {})
    local slice=options.sliceWork or 128
    if not U.finite(slice) or slice%1~=0 or slice<1 or slice>1024 then return nil,"invalid-training-slice" end
    local canceled=false; local work=0; local slices=0; local inSlice=0
    local model,reason; local job={}
    local worker=coroutine.create(function()
        model,reason=T.train(records,options,function()
            if canceled then return false end
            work+=1; inSlice+=1
            if inSlice>=slice then coroutine.yield() end
            return not canceled
        end)
    end)
    function job.cancel() canceled=true; model=nil; reason="training-canceled" end
    function job.step()
        if canceled then return true,nil,{status="canceled",reason=reason,work=work,slices=slices} end
        if coroutine.status(worker)~="dead" then
            inSlice=0; slices+=1
            local ok,err=coroutine.resume(worker)
            if not ok then reason=tostring(err); canceled=true; model=nil end
        end
        local done=canceled or coroutine.status(worker)=="dead"
        return done,model,{status=not done and "running" or model and "trained-offline" or "failed",reason=reason,work=work,slices=slices}
    end
    return job
end
function T.toLua(value)
    local function encode(v,seen)
        local kind=type(v)
        if kind=="number" then assert(U.finite(v),"nonfinite-export-value"); return string.format("%.17g",v) end
        if kind=="string" then return string.format("%q",v) end
        if kind=="boolean" then return v and "true" or "false" end
        assert(kind=="table" and not seen[v],"unsupported-or-cyclic-export")
        seen[v]=true; local parts={}
        if U.array(v) then
            for _,item in ipairs(v) do parts[#parts+1]=encode(item,seen) end
        else
            local keys={}; for key in pairs(v) do assert(type(key)=="string","string-export-keys-required"); keys[#keys+1]=key end
            table.sort(keys)
            for _,key in ipairs(keys) do parts[#parts+1]="["..encode(key,seen).."]="..encode(v[key],seen) end
        end
        seen[v]=nil; return "{"..table.concat(parts,",").."}"
    end
    return "-- SmartFit model artifact; verify provenance/evaluation before use.\nreturn "..encode(value,{}).."\n"
end
return T

end

factories["Util"]=function()

local U = {}
function U.finite(n) return type(n) == "number" and n == n and math.abs(n) < math.huge end
function U.vec(v)
    return type(v) == "table" and U.finite(v.x) and U.finite(v.y) and U.finite(v.z)
end
function U.array(value,maximum)
    if type(value)~="table" or #value>(maximum or math.huge) then return false end
    local count=0
    for k in pairs(value) do
        if type(k)~="number" or k%1~=0 or k<1 or k>#value then return false end
        count+=1
    end
    return count==#value
end
function U.v(x,y,z) return {x=x or 0,y=y or 0,z=z or 0} end
function U.add(a,b) return U.v(a.x+b.x,a.y+b.y,a.z+b.z) end
function U.sub(a,b) return U.v(a.x-b.x,a.y-b.y,a.z-b.z) end
function U.mul(a,s) return U.v(a.x*s,a.y*s,a.z*s) end
function U.dot(a,b) return a.x*b.x+a.y*b.y+a.z*b.z end
function U.norm(a) return math.sqrt(U.dot(a,a)) end
function U.distance(a,b) return U.norm(U.sub(a,b)) end
function U.unit(a) local n=U.norm(a); return n>1e-12 and U.mul(a,1/n) or U.v() end
function U.copy(value,seen)
    if type(value)~="table" then return value end
    seen=seen or {}; assert(not seen[value],"cyclic input")
    seen[value]=true; local out={}
    for k,v in pairs(value) do out[k]=U.copy(v,seen) end
    seen[value]=nil; return out
end
function U.freeze(t)
    if type(t)~="table" then return t end
    for _,v in pairs(t) do if type(v)=="table" and not table.isfrozen(v) then U.freeze(v) end end
    return table.freeze(t)
end
function U.owned(t) return U.freeze(U.copy(t)) end
return U

end

factories["RobloxAdapter"]=function()
-- Roblox-only presentation adapter. Require the bundled Engine ModuleScript
-- in your own Studio project, then call Adapter.draw(Engine,...).
local Adapter={}
function Adapter.vector(value) return {x=value.X,y=value.Y,z=value.Z} end
local function frame(position,tangent,api)
    local Vec=api.Vector3
    if tangent.Magnitude<1e-10 then tangent=Vec.xAxis end
    local right=tangent.Unit
    local seed=math.abs(right:Dot(Vec.yAxis))<0.95 and Vec.yAxis or Vec.zAxis
    local back=right:Cross(seed).Unit
    local up=back:Cross(right).Unit
    return api.CFrame.fromMatrix(position,right,up,back)
end
function Adapter.draw(Engine,beam,attachment0,attachment1,solution,api)
    api=api or {Vector3=Vector3,CFrame=CFrame}
    local function native(value) return api.Vector3.new(value.x,value.y,value.z) end
    local p=Engine.trajectory.bezier(solution)
    local a,b,c,d=native(p[1]),native(p[2]),native(p[3]),native(p[4])
    attachment0.WorldCFrame=frame(a,b-a,api)
    attachment1.WorldCFrame=frame(d,d-c,api)
    beam.Attachment0=attachment0; beam.Attachment1=attachment1
    beam.CurveSize0=(b-a).Magnitude
    beam.CurveSize1=(d-c).Magnitude
    beam.Enabled=true
end
return Adapter

end
