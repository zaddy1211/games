    assert(U.finite(regularization) and regularization>=0 and regularization<=1,"invalid-regularization")
    assert(U.finite(seed) and seed%1==0 and seed>0 and seed<2147483647,"invalid-seed")
    assert(U.finite(lifetime) and lifetime>0,"invalid-model-lifetime")
    local function work() if tick then assert(tick(),"training-canceled") end end
