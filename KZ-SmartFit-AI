        mean=mean,scale=scale,min=minimum,max=maximum,createdAt=options.unixNow,expiresAt=options.unixNow+lifetime}
    local evaluation={trainCount=#sets[1],validationCount=#sets[2],testCount=#sets[3],groupDisjoint=true,
        bothLabelsHaveBothClasses=true,seed=seed,epochs=epochs,splitGroups=groupNames,trainer="smartfit-luau-v1"}
