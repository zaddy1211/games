local factories,cache={},{}
local load
load=function(name)
 if cache[name]~=nil then return cache[name] end
 assert(factories[name], 'Unknown module: '..name)
 local value=factories[name](); cache[name]=value; return value
end

factories["Config"]=function()
local U=load("Util")
local Motion=load("Motion")
local C={}
local defaults={minFlightTime=0.01,maxFlightTime=7,minAngle=-math.pi/2,maxAngle=math.pi/2,
    endpointTolerance=0.0001,maxSnapshotAge=0.25,maxDefenders=64,maxMotionChanges=8,
    maxCandidates=96,maxDefenseNodes=12000,maxWork=200000,maxCpuSeconds=0.1,
    sliceSeconds=0.002,sliceWork=256,defenseTimeTolerance=0.0001,
    offsets={{x=0,y=0,z=0}},powers={40,50,60,70,80,95}}
local function nonnegative(t,keys)
    for _,k in ipairs(keys) do if not U.finite(t[k]) or t[k]<0 then return false,k end end
    return true
end
function C.prepare(input)
    if type(input)~="table" then return nil,"configuration-required" end
    local c=U.copy(input)
    for k,v in pairs(defaults) do if c[k]==nil then c[k]=U.copy(v) end end
    if type(c.calibration)~="table" or type(c.calibration.id)~="string" or c.calibration.id==""
        or type(c.calibration.source)~="string" or c.calibration.source=="" then return nil,"calibration-provenance-required" end
    if c.calibration.status~="measured" and not (c.calibration.status=="synthetic" and c.allowSynthetic==true) then
        return nil,"measured-calibration-required"
    end
    local ok,key=nonnegative(c,{"gravity","launchOffset","velocityInheritance","networkDelay","releaseDelay",
        "fieldMargin","safetyMargin","maxActorSpeed","maxActorAcceleration"})
    if not ok or c.gravity==0 then return nil,"missing-or-invalid-physical-parameter:"..tostring(key or "gravity") end
    if c.velocityInheritance>1 then return nil,"inheritance-out-of-range" end
    for _,k in ipairs({"endpointTolerance","minFlightTime","maxFlightTime","maxSnapshotAge","maxDefenders",
        "maxMotionChanges","maxCandidates","maxDefenseNodes","maxWork","maxCpuSeconds","sliceSeconds","sliceWork","defenseTimeTolerance"}) do
        if not U.finite(c[k]) or c[k]<=0 then return nil,"invalid-budget-or-tolerance:"..k end
    end
    if c.maxFlightTime<=c.minFlightTime or not U.finite(c.minAngle) or not U.finite(c.maxAngle)
        or c.minAngle < -math.pi/2 or c.maxAngle>math.pi/2 or c.maxAngle<c.minAngle then return nil,"invalid-time-or-angle-window" end
    for _,name in ipairs({"receiver","defender"}) do
        local s=c[name]
        if type(s)~="table" then return nil,"reach-calibration-required:"..name end
        local valid,missing=nonnegative(s,{"horizontal","up","down","reaction","correctionSpeed","correctionDistance",
            "uncertainty","uncertaintyRate","accelerationUncertainty","jumpSpeed","jumpGravity","jumpDelay",
            "diveSpeed","diveDistance","diveDelay","diveDuration"})
        if not valid or s.jumpGravity==0 or type(s.allowJumpDive)~="boolean" or type(s.allowAirDive)~="boolean" then
            return nil,"invalid-reach-calibration:"..name..":"..tostring(missing)
        end
    end
    local b=c.bounds
    if type(b)~="table" then return nil,"field-bounds-required" end
    for _,k in ipairs({"xMin","xMax","zMin","zMax","minY"}) do if not U.finite(b[k]) then return nil,"invalid-field-bounds" end end
    if b.xMax-b.xMin<=2*c.fieldMargin or b.zMax-b.zMin<=2*c.fieldMargin then return nil,"invalid-field-margin" end
    local samples=c.powerSamples
    if not U.array(samples,64) or #samples<2 then return nil,"power-speed-calibration-required" end
    for i,s in ipairs(samples) do
        if type(s)~="table" or not U.finite(s.power) or not U.finite(s.speed) or s.speed<=0
            or (i>1 and (s.power<=samples[i-1].power or s.speed<samples[i-1].speed)) then return nil,"invalid-power-speed-samples" end
    end
    if samples[1].power~=40 or samples[#samples].power~=95 then return nil,"power-calibration-must-span-40-to-95" end
    if not U.array(c.powers,56) or #c.powers==0 then return nil,"invalid-power-search" end
    for _,p in ipairs(c.powers) do if not U.finite(p) or p<40 or p>95 then return nil,"power-out-of-range" end end
    if not U.array(c.offsets,16) or #c.offsets==0 then return nil,"invalid-placement-search" end
    for _,v in ipairs(c.offsets) do if not U.vec(v) then return nil,"invalid-placement" end end
    return U.freeze(c)
end
function C.speed(c,power)
    for i=2,#c.powerSamples do
        local a,b=c.powerSamples[i-1],c.powerSamples[i]
        if power>=a.power and power<=b.power then return a.speed+(b.speed-a.speed)*(power-a.power)/(b.power-a.power) end
    end
    return nil
end
function C.snapshot(snapshot,now,c)
    if type(snapshot)~="table" or not U.finite(now) or not U.finite(snapshot.timestamp)
        or now<snapshot.timestamp or now-snapshot.timestamp>c.maxSnapshotAge then return nil,"stale-or-invalid-observation" end
    if snapshot.defendersObserved~=true or not U.array(snapshot.defenders) then return nil,"defender-observation-required" end
    if #snapshot.defenders>c.maxDefenders then return nil,"too-many-defenders" end
    local horizon=c.maxSnapshotAge+c.networkDelay+c.releaseDelay+c.maxFlightTime
    local function actor(a,reach)
        if type(a)~="table" or (type(a.id)~="string" and not U.finite(a.id)) or not U.vec(a.position)
            or not U.vec(a.velocity) or (a.acceleration~=nil and not U.vec(a.acceleration))
            or type(a.grounded)~="boolean" then return false end
        if (a.grounded and a.velocity.y~=0) or (a.acceleration and a.acceleration.y~=0) then return false end
        if not a.grounded and (not U.finite(a.groundY) or a.groundY>a.position.y) then return false end
        if a.uncertainty~=nil and (not U.finite(a.uncertainty) or a.uncertainty<0) then return false end
        if a.diveDirection~=nil and not U.vec(a.diveDirection) then return false end
        if a.acceleration~=nil and U.norm(a.acceleration)>0 and (not U.finite(a.accelerationUntil) or a.accelerationUntil<=0) then return false end
        if a.accelerationUntil~=nil and (not U.finite(a.accelerationUntil) or a.accelerationUntil<0 or a.accelerationUntil>horizon) then return false end
        if a.changes~=nil and not U.array(a.changes,c.maxMotionChanges) then return false end
        local last=0
        for _,change in ipairs(a.changes or {}) do
            if type(change)~="table" or not U.finite(change.time) or change.time<=last or change.time>=horizon
                or not U.vec(change.velocity) or (change.acceleration~=nil and not U.vec(change.acceleration)) then return false end
            if change.velocity.y~=0 or (change.acceleration and change.acceleration.y~=0) then return false end
            last=change.time
        end
        local segments=Motion.segments(a,horizon,reach.jumpGravity)
        if Motion.speedBound(segments,0,horizon)>c.maxActorSpeed then return false end
        for _,s in ipairs(segments) do if U.norm(s.acceleration)>c.maxActorAcceleration then return false end end
        return true
    end
    if not actor(snapshot.qb,c.receiver) or not actor(snapshot.receiver,c.receiver) then return nil,"invalid-qb-or-receiver" end
    local ids={}
    for _,a in ipairs(snapshot.defenders) do
        if not actor(a,c.defender) or ids[a.id] then return nil,"invalid-or-duplicate-defender" end
        ids[a.id]=true
    end
    local function clean(a)
        local out={id=a.id,position=U.v(a.position.x,a.position.y,a.position.z),
            velocity=U.v(a.velocity.x,a.velocity.y,a.velocity.z),grounded=a.grounded,
            groundY=a.groundY,uncertainty=a.uncertainty,accelerationUntil=a.accelerationUntil}
        if a.acceleration then out.acceleration=U.v(a.acceleration.x,a.acceleration.y,a.acceleration.z) end
        if a.diveDirection then out.diveDirection=U.v(a.diveDirection.x,a.diveDirection.y,a.diveDirection.z) end
        if a.changes then
            out.changes={}
            for i,change in ipairs(a.changes) do
                out.changes[i]={time=change.time,velocity=U.v(change.velocity.x,change.velocity.y,change.velocity.z)}
                if change.acceleration then out.changes[i].acceleration=U.v(change.acceleration.x,change.acceleration.y,change.acceleration.z) end
            end
        end
        return out
    end
    local out={timestamp=snapshot.timestamp,defendersObserved=true,qb=clean(snapshot.qb),receiver=clean(snapshot.receiver),defenders={}}
    for i,a in ipairs(snapshot.defenders) do out.defenders[i]=clean(a) end
    return U.freeze(out)
end
return C

end

factories["Defense"]=function()
local Motion=load("Motion")
local Physics=load("Physics")
local Reach=load("Reach")
local D={}
function D.evaluate(solution,defenders,motions,c,tick)
    local stats={nodes=0,minimumMargin=math.huge}
    for index,actor in ipairs(defenders) do
        local segments=motions[index]
        local stack={{0,solution.flightTime}}
        while #stack>0 do
            stats.nodes+=1
            if stats.nodes>c.maxDefenseNodes or (tick and not tick()) then
                return false,{reason="defense-budget-exhausted",nodes=stats.nodes}
            end
            local interval=table.remove(stack)
            local lo,hi=interval[1],interval[2]; local mid=(lo+hi)/2
            local bx,by,bz=Physics.coordinates(solution,mid)
            local ax,ay,az=Motion.coordinates(segments,solution.delay+mid)
            local dx,dy,dz=bx-ax,by-ay,bz-az
            local radius,up,down=Reach.defenderEnvelope(actor,hi,solution.delay+hi,c.defender)
            radius+=c.safetyMargin; up+=c.safetyMargin; down+=c.safetyMargin
            local horizontal=math.sqrt(dx*dx+dz*dz)
            local ballSpeed=math.max(Physics.speedAt(solution,lo),Physics.speedAt(solution,hi))
            local actorSpeed=Motion.speedBound(segments,solution.delay+lo,solution.delay+hi)
            -- Lipschitz displacement bound applies across velocity-change boundaries too.
            local movement=(ballSpeed+actorSpeed)*(hi-lo)*0.5
            local lowerMargin=math.max(horizontal-radius,dy-up,-dy-down)-movement
            if lowerMargin>0 then
                stats.minimumMargin=math.min(stats.minimumMargin,lowerMargin)
            else
                local r,u,d=Reach.defenderEnvelope(actor,mid,solution.delay+mid,c.defender)
                if horizontal<=r+c.safetyMargin and dy<=u+c.safetyMargin and dy>=-d-c.safetyMargin then
                    return false,{reason="defender-reachable",defenderId=actor.id,time=mid,
                        timeFlight=mid,timeObservation=solution.delay+mid,nodes=stats.nodes}
                end
                if hi-lo<=c.defenseTimeTolerance then
                    return false,{reason="defender-interval-unresolved",defenderId=actor.id,time=mid,
                        timeFlight=mid,timeObservation=solution.delay+mid,nodes=stats.nodes}
                end
                stack[#stack+1]={mid,hi}; stack[#stack+1]={lo,mid}
            end
        end
    end
    return true,stats
end
return D

end

factories["Engine"]=function()
local U=load("Util")
local Config=load("Config")
local Search=load("Search")
local Physics=load("Physics")
local Model=load("Model")
local Telemetry=load("Telemetry")
local Training=load("Training")
local Engine={version="1.1.1",trajectory=Physics,trainOffline=Training.train,
    newTrainingJob=Training.newJob,modelToLua=Training.toLua}
function Engine.new(input)
    local ok,c,why=pcall(Config.prepare,input)
    if not ok then return nil,"invalid-configuration:"..tostring(c) end
    if not c then return nil,why end
    local snapshot,version,active,model=nil,0,nil,nil
    local telemetryOK,telemetry=pcall(Telemetry.new,c.telemetry,
        c.calibration.status=="synthetic" and "synthetic" or "authorized-gameplay")
    if not telemetryOK then return nil,"invalid-telemetry-configuration" end
    local engine={}; local closed=false
    function engine.update(value,now)
        if closed then return false,"engine-closed" end
        local success,owned,reason=pcall(Config.snapshot,value,now,c)
        version+=1; if active then active.cancel() end
        snapshot=nil
        if not success then return false,"invalid-observation:"..tostring(owned) end
        if not owned then return false,reason end
        snapshot=owned; return true
    end
    function engine.loadModel(artifact,unixNow)
        local success,value,reason=pcall(Model.load,artifact,unixNow,c.calibration.id)
        model=nil
        if not success then return false,"model-malformed" end
        model=value; return value~=nil,reason
    end
    function engine.start(now,unixNow)
        if closed or not snapshot then return nil,"observation-required" end
        if not U.finite(now) or now<snapshot.timestamp or now-snapshot.timestamp>c.maxSnapshotAge then
            return nil,"stale-or-invalid-observation"
        end
        if active then active.cancel() end
        local captured,jobVersion=snapshot,version
        local sliceWorkBudget=math.max(1,math.floor(c.sliceWork/(1+#snapshot.defenders/32)))
        local diagnostics={status="running",evaluated=0,valid=0,work=0,slices=0,
            maxSliceSeconds=0,cpuSeconds=0,rejections={},ranking="deterministic",sliceWorkBudget=sliceWorkBudget}
        local canceled,exhausted=false,false
        local sliceStart,sliceOps=0,0
        local result; local job={}
        local function tick()
            if canceled or version~=jobVersion or exhausted then return false end
            diagnostics.work+=1; sliceOps+=1
            local elapsed=os.clock()-sliceStart
            if diagnostics.work>=c.maxWork or diagnostics.cpuSeconds+elapsed>=c.maxCpuSeconds then
                exhausted=true; diagnostics.budgetExhausted=true; return false
            end
            if sliceOps>=sliceWorkBudget or elapsed>=c.sliceSeconds then
                coroutine.yield()
                if canceled or version~=jobVersion then return false end
            end
            return true
        end
        local worker=coroutine.create(function()
            result=Search.run(captured,now,c,model,unixNow,tick,diagnostics)
            if canceled or version~=jobVersion then result=nil; diagnostics.status="canceled"
            elseif result then
                result.snapshotVersion=jobVersion
                result.releaseAt=result.timing.releaseAt
                result=U.freeze(result); diagnostics.status="solved"
            else diagnostics.status=exhausted and "budget-exhausted" or "no-safe-candidate" end
        end)
        function job.cancel() canceled=true; result=nil; diagnostics.status="canceled" end
        function job.step()
            if canceled then return true,nil,U.owned(diagnostics) end
            if coroutine.status(worker)=="dead" then return true,result,U.owned(diagnostics) end
            sliceStart=os.clock(); sliceOps=0
            local success,errorMessage=coroutine.resume(worker)
            local elapsed=os.clock()-sliceStart
            diagnostics.cpuSeconds+=elapsed
            diagnostics.maxSliceSeconds=math.max(diagnostics.maxSliceSeconds,elapsed)
            diagnostics.slices+=1
            if not success then result=nil; canceled=true; diagnostics.status="error"; diagnostics.error=tostring(errorMessage) end
            return canceled or coroutine.status(worker)=="dead",result,U.owned(diagnostics)
        end
        active=job; return job
    end
    function engine.solve(now,unixNow)
        local job,reason=engine.start(now,unixNow)
        if not job then return nil,{status="failed",reason=reason} end
        while true do local done,result,diagnostics=job.step(); if done then return result,diagnostics end end
    end
    function engine.validate(solution,now)
        if closed or not snapshot or type(solution)~="table" or solution.snapshotVersion~=version then return false,"stale-snapshot-version" end
        if not U.finite(now) or not U.finite(solution.plannedAt) or not U.finite(solution.releaseAt)
            or now<solution.plannedAt or now>solution.releaseAt then return false,"release-window-expired" end
        if not U.finite(solution.delay) or math.abs(solution.releaseAt-(snapshot.timestamp+solution.delay))>1e-9 then
            return false,"release-contract-mismatch"
        end
        if now<snapshot.timestamp or now-snapshot.timestamp>c.maxSnapshotAge then return false,"stale-or-invalid-observation" end
        local used=0; local started=os.clock()
        local function tick() used+=1; return used<c.maxWork and os.clock()-started<c.maxCpuSeconds end
        local success,valid,details=pcall(Search.validate,solution,snapshot,Search.context(snapshot,solution.plannedAt,c),c,tick)
        if not success then return false,"malformed-solution" end
        return valid,details
    end
    function engine.beginThrow(id,groupId,solution,now)
        local valid,reason=engine.validate(solution,now); if not valid then return false,reason end
        local verified=U.copy(solution)
        verified.validation=reason; verified.endpointError=reason.endpointError; verified.status="valid"
        return telemetry.begin(id,groupId,verified,snapshot,c.calibration.id)
    end
    function engine.recordOutcome(id,outcome) return telemetry.finish(id,outcome) end
    function engine.drainTelemetry(limit) return telemetry.drain(limit) end
    function engine.cancelThrow(id) telemetry.cancel(id) end
    function engine.shutdown()
        closed=true; version+=1; if active then active.cancel() end
        snapshot=nil; model=nil; telemetry.clear()
    end
    return engine
end
return Engine

end

