factories["Model"]=function()
local U=load("Util")
local F=load("Features")
local M={}
local function vector(t,n,positive)
    if not U.array(t,n) or #t~=n then return false end
    for _,v in ipairs(t) do if not U.finite(v) or (positive and v<=0) then return false end end
    return true
end
function M.load(artifact,now,calibrationId)
    if type(artifact)~="table" then return nil,"model-unavailable" end
    local m=artifact; local n=#F.names
    if m.schemaVersion~=F.version or type(m.version)~="string" or m.version==""
        or m.calibrationId~=calibrationId or m.dataOrigin~="authorized-gameplay"
        or m.qualified~=true or not U.finite(m.expiresAt) or not U.finite(now) or now>m.expiresAt
        or not U.finite(m.createdAt) or now<m.createdAt or m.expiresAt<=m.createdAt then return nil,"model-unqualified-or-stale" end
    if not U.array(m.featureNames,n) or #m.featureNames~=n then return nil,"model-schema-mismatch" end
    for i,name in ipairs(F.names) do if m.featureNames[i]~=name then return nil,"model-schema-mismatch" end end
    for _,key in ipairs({"mean","min","max"}) do if not vector(m[key],n,false) then return nil,"model-malformed" end end
    if not vector(m.scale,n,true) then return nil,"model-malformed" end
    for i=1,n do if m.min[i]>m.max[i] then return nil,"model-malformed" end end
    for _,key in ipairs({"catch","interception"}) do
        if type(m[key])~="table" or not vector(m[key].weights,n,false) or not U.finite(m[key].bias) then return nil,"model-malformed" end
    end
    local e=m.evaluation
    if type(e)~="table" or not U.finite(e.testCount) or e.testCount<100
        or not U.finite(e.trainCount) or e.trainCount<300 or not U.finite(e.validationCount) or e.validationCount<100 or e.groupDisjoint~=true
        or e.bothLabelsHaveBothClasses~=true or not U.finite(e.catchBrier) or e.catchBrier<0 or e.catchBrier>0.22
        or not U.finite(e.interceptionBrier) or e.interceptionBrier<0 or e.interceptionBrier>0.22
        or not U.finite(e.catchBaselineBrier) or e.catchBrier>e.catchBaselineBrier
        or not U.finite(e.interceptionBaselineBrier) or e.interceptionBrier>e.interceptionBaselineBrier then
        return nil,"model-evaluation-gate-failed"
    end
    for _,name in ipairs({"catch","interception"}) do
        local v=e[name.."Validation"]
        if type(v)~="table" or not U.finite(v.brier) or v.brier<0 or v.brier>0.22
            or not U.finite(v.baselineBrier) or v.brier>v.baselineBrier then return nil,"model-evaluation-gate-failed" end
    end
    return U.owned(m),"model-loaded"
end
function M.predict(m,features,now)
    if not m or not U.finite(now) or now<m.createdAt or now>m.expiresAt then return nil,"model-unavailable-or-expired" end
    local normalized={}
    for i,value in ipairs(features) do
        if not U.finite(value) or value<m.min[i] or value>m.max[i] then return nil,"model-out-of-domain" end
        normalized[i]=(value-m.mean[i])/m.scale[i]
    end
    if #normalized~=#F.names then return nil,"model-schema-mismatch" end
    local function probability(head)
        local z=head.bias
        for i,v in ipairs(normalized) do z+=head.weights[i]*v end
        z=math.clamp(z,-35,35); return 1/(1+math.exp(-z))
    end
    return {catchProbability=probability(m.catch),interceptionRisk=probability(m.interception),version=m.version}
end
return M

end

factories["Motion"]=function()
local U=load("Util")
local M={}
function M.landingTime(actor,gravity)
    if actor.grounded then return 0 end
    local height=actor.position.y-actor.groundY
    return (actor.velocity.y+math.sqrt(actor.velocity.y^2+2*gravity*height))/gravity
end
function M.segments(actor,horizon,gravity)
    local events={0,horizon}
    local untilTime=actor.accelerationUntil or 0
    local landing=gravity and not actor.grounded and M.landingTime(actor,gravity) or nil
    if landing and landing>0 and landing<horizon then events[#events+1]=landing end
    if untilTime>0 and untilTime<horizon then events[#events+1]=untilTime end
    for _,change in ipairs(actor.changes or {}) do
        if change.time>0 and change.time<horizon then events[#events+1]=change.time end
    end
    table.sort(events)
    local p,v=actor.position,actor.velocity
    local a=untilTime>0 and (actor.acceleration or U.v()) or U.v()
    local result={}; local changed=false
    for i=1,#events-1 do
        local start,finish=events[i],events[i+1]
        if start==untilTime and not changed then a=U.v() end
        for _,change in ipairs(actor.changes or {}) do
            if change.time==start then
                v=change.velocity
                a=change.acceleration or U.v()
                changed=true
            end
        end
        if finish>start then
            if landing then
                -- Vertical flight/landing is independent of horizontal route plans.
                p=U.v(p.x,start>=landing and actor.groundY or actor.position.y+actor.velocity.y*start-0.5*gravity*start*start,p.z)
                v=U.v(v.x,start>=landing and 0 or actor.velocity.y-gravity*start,v.z)
                a=U.v(a.x,start>=landing and 0 or -gravity,a.z)
            end
            result[#result+1]={start=start,finish=finish,position=p,velocity=v,acceleration=a}
            local dt=finish-start
            p=U.add(U.add(p,U.mul(v,dt)),U.mul(a,0.5*dt*dt))
